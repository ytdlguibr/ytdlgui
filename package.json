{
  "name": "ytdl-studio",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:api": "vite build --config apps/api/vite.config.ts",
    "build:extension": "vite build --config apps/extension/vite.config.ts",
    "dev:api": "npm run build:api && node apps/api/dist/server.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:standalone": "./scripts/build_standalone.sh",
    "build:standalone:arm64": "YTDL_STUDIO_BUILD_TARGET=aarch64-apple-darwin ./scripts/build_standalone.sh",
    "build:standalone:intel": "YTDL_STUDIO_BUILD_TARGET=x86_64-apple-darwin ./scripts/build_standalone.sh",
    "diagnose:macos": "./scripts/diagnose_macos_bundle.sh",
    "update:sidecars": "./scripts/update_sidecars.sh",
    "release:desktop": "./scripts/release_desktop.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
