# Porta do servidor da API
PORT=8787

# Token de autenticação Bearer para chamadas da API
# Se vazio e DEV_AUTH=1, permite requisições sem autenticação (ideal para testes locais)
# Para produção, defina uma string segura: ex. YTDL_STUDIO_API_TOKEN=seu_token_secreto_aqui
YTDL_STUDIO_API_TOKEN=

# Habilitar modo de desenvolvimento (permite requisições sem Bearer token)
# 1 = ativo, 0 = inativo (obrigatório token)
YTDL_STUDIO_DEV_AUTH=1

# URL pública base usada para gerar os links de download dos jobs
YTDL_STUDIO_PUBLIC_BASE_URL=http://localhost:8787

# Diretório onde os downloads temporários serão armazenados (dentro do container: /downloads)
YTDL_STUDIO_OUTPUT_DIR=/downloads

# Caminho para o binário do yt-dlp (configurado automaticamente no Dockerfile)
YTDL_STUDIO_YTDLP_PATH=/usr/local/bin/yt-dlp

# Caminho para o binário do ffmpeg (configurado automaticamente no Dockerfile)
YTDL_STUDIO_FFMPEG_PATH=/usr/bin/ffmpeg
