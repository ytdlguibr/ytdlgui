{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YTDL Studio",
  "version": "0.1.3",
  "identifier": "com.capitolio.ytdl-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YTDL Studio",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg",
      "binaries/deno"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0QTE3MDQ2MjNBMkY2NzgKUldSNDlxSWpSbkNocElEWVRxdzZsckl3OVdPZVI2TVZFWWVscWtLa2VJQWdMeXlZVWN2eUo4RmkK",
      "endpoints": [
        "https://github.com/ytdlguibr/ytdlgui/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
